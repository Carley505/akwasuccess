# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@akwasuccess.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_CAL_LINK=

# Database (leave blank in local dev to use embedded PGlite at ./.data/pglite)
DATABASE_URL=

# Auth & Admin
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=callistusngeywa001@gmail.com

# Sample data control (set SHOW_SAMPLE_DATA=false in production)
SHOW_SAMPLE_DATA=true

# Payments: Card Checkout (USD) — In-site Paystack Inline Popup (can be added later)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Headless WordPress / WooCommerce Backend (server-only — NEVER expose consumer keys to client)
WOOCOMMERCE_URL=https://cms.akwasuccess.com
WOOCOMMERCE_GRAPHQL_URL=https://cms.akwasuccess.com/graphql
WOOCOMMERCE_CONSUMER_KEY=ck_your_woocommerce_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret_here
WOOCOMMERCE_WEBHOOK_SECRET=

# Private file storage (optional S3 / Cloudflare R2; falls back to ./storage/private)
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Transactional & newsletter email (Resend; falls back to ./.data/outbox in dev)
EMAIL_API_KEY=
EMAIL_FROM="Akwasuccess <hello@akwasuccess.com>"
