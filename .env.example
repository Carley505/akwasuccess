# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@akwasuccess.com
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000
NEXT_PUBLIC_USD_RATE=129
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_CAL_LINK=

# Database (leave blank in local dev to use embedded PGlite at ./.data/pglite)
DATABASE_URL=

# Auth & Admin
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=owner@akwasuccess.com

# Sample data control (set SHOW_SAMPLE_DATA=false in production)
SHOW_SAMPLE_DATA=true

# Payments: Safaricom Daraja M-Pesa STK Push
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/api/webhooks/mpesa
MPESA_WEBHOOK_SECRET=

# Payments: Paystack (Card + M-Pesa)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Private file storage (optional S3 / Cloudflare R2; falls back to ./storage/private)
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Transactional & newsletter email (Resend; falls back to ./.data/outbox in dev)
EMAIL_API_KEY=
EMAIL_FROM="Akwasuccess <hello@akwasuccess.com>"
